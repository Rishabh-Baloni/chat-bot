# Copy this file to .env and add your API keys

# Required: Get from https://console.groq.com/keys
GROK_API_KEY=your_groq_api_key_here

# Required: Get from https://aistudio.google.com/app/apikey
# (Used only by the optional knowledge-expansion path; the chat endpoint works without it.)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port for local development (default: 8000; Render sets this automatically)
PORT=8000

# Optional safety knobs — all have safe defaults, you do NOT need to set these.
# Comma-separated origins, or "*" for any. Default: *
# ALLOWED_ORIGINS=https://your-fitness-app.com,https://www.your-fitness-app.com

# Max characters accepted per user message. Default: 2000
# MAX_MESSAGE_LENGTH=2000

# Max conversation turns kept in memory per session. Default: 20
# MAX_TURNS_PER_SESSION=20

# Max concurrent sessions in memory. Default: 5000
# MAX_SESSIONS=5000

# Seconds before an idle session is evicted from memory. Default: 3600
# SESSION_TTL_SECONDS=3600

# Per-IP rate limit. Defaults: 30 requests per 60 seconds.
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX_REQUESTS=30
